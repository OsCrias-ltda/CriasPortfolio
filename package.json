{
  "name": "crias-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-loader.mjs --test tests/*.test.mts",
    "check": "npm run typecheck && npm run lint && npm test",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "prepare": "if [ -d .git ] && command -v git >/dev/null 2>&1; then git config core.hooksPath .githooks; fi"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "^16.4.6",
    "nodemailer": "^6.9.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "latest",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.7.3"
  }
}
