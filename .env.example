# Ambiente da aplicação: production (padrão) ou staging (ativa noindex e Disallow: /)
APP_ENV=production

# URL pública base usada em canonical, OpenGraph, sitemap e llms.txt (sobrescreve seo.siteUrl)
NEXT_PUBLIC_BASE_URL=https://grupocrias.com

# Tenant ativo para modo single-tenant clonável (opcional; usa DEFAULT_TENANT_SLUG se vazio)
ACTIVE_TENANT=crias

# Provedor de conteúdo: local (padrão) ou payload (quando plugar Payload CMS)
CONTENT_PROVIDER=local

# Configuração SMTP para o formulário de contato (/api/contact)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
